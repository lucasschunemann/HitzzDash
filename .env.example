# Obrigatória: coleta de Reels e perfis no Instagram (https://console.apify.com/settings/integrations)
# O plano gratuito do Apify vem com crédito mensal.
APIFY_TOKEN=

# Opcionais (modo pago/automático). Sem elas o app usa o modo gratuito:
#  - transcrição com Whisper local (rode: npm run setup:whisper)
#  - análise, resumo e roteiros pelo Claude Code (skill .claude/skills/hitzz)
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Nuvem (dashboard na Vercel). Coloque os MESMOS valores aqui no Mac e na Vercel.
# Banco Turso (a integração da Vercel cria como TURSO_DATABASE_URL / TURSO_AUTH_TOKEN; os dois nomes funcionam)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Senha única da equipe para entrar no dashboard (obrigatória na Vercel)
DASHBOARD_PASSWORD=

# Ajustes (opcionais)
# Força o transcritor: local | elevenlabs
TRANSCRIBER=
# Força quem analisa: claude_code | api
ANALYZER=
# Modelo do Claude na API (padrão: claude-opus-5)
ANTHROPIC_MODEL=
# Caminho de outro modelo do Whisper (padrão: models/ggml-large-v3-turbo-q5_0.bin)
WHISPER_MODEL=
# Pasta dos dados locais (banco + mídia). Padrão: ./data
DATA_DIR=
